# The startup script enforces production, 0.0.0.0 and HTTP port 3000.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Run scripts/setup-https.ps1 after the web build. It creates the private PFX
# outside dist and replaces TLS_PFX_PASSWORD with a random 64-character hex value.
HTTPS_PORT=3443
TLS_PFX_PATH=C:/Games/YarGram/runtime/https/yargram-server.pfx
TLS_PFX_PASSWORD=generated-by-scripts-setup-https-ps1

# Replace this value if you create .env manually. Use at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# За обратным прокси (Cloudflare Tunnel, nginx) доверяем X-Forwarded-Proto,
# иначе сеансы запишутся как http://… Даёт произвольное число прокси в цепочке.
# Возможные значения: false (прокси нет), true (доверять всем, если прокси
# действительно один и настроен у вас), либо строка подсетей через запятую,
# например loopback, linklocal, uniquelocal.
TRUST_PROXY=false

# Перенаправлять ли вход по HTTP на HTTPS. По умолчанию false — и это важно.
# Флаг имеет смысл только за прокси, который сообщает исходную схему запроса
# в X-Forwarded-Proto (и тогда же включите TRUST_PROXY). Без такого прокси
# сервер считает «http» любой запрос — даже уже защищённый — и уводит его на
# HTTPS, а это бесконечный цикл: сайт перестаёт открываться вовсе.
# Отдельно про Cloudflare: в режиме SSL/TLS «Flexible» он сам ходит к серверу
# по HTTP, поэтому перенаправление там включает Cloudflare («Always Use
# HTTPS»), а этот флаг оставляют выключенным.
FORCE_HTTPS=false

# Откуда Yargram открывают. Значение служит и белым списком для CORS, и
# подсказкой лаунчеру, какую ссылку печатать друзьям. Переменные окружения
# RADMIN_IP, PORT, HTTPS_PORT и YARGRAM_ALLOWED_NETWORKS перебивают значения
# по умолчанию в скриптах на вашей машине.
PUBLIC_ORIGIN=http://26.53.76.128:3000

# Два сайта: корень занимает лендинг (apps/landing), само приложение — /app.
# Приложение собирается с базовым путём /app (base в apps/web/vite.config.ts);
# переопределить можно переменной VITE_BASE, если приложение выносят на
# отдельный домен — тогда VITE_BASE=/ и лендингу нужен VITE_APP_URL с его адресом.
# VITE_BASE=/app/

# HTTP 3000 остаётся доступен; HTTPS 3443 нужен браузеру для звонков.
# Порт 5173 используется только Vite в режиме разработки.
CORS_ORIGINS=http://26.53.76.128:3000,https://26.53.76.128:3443,http://localhost:3000,https://localhost:3443,http://127.0.0.1:3000,https://127.0.0.1:3443,http://26.53.76.128:5173,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL: start npm run db:local; copy settings from runtime/postgres/database.env.
# Or use an existing PostgreSQL 16+ server with UTF8 encoding.
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://yargram:YOUR_PASSWORD@127.0.0.1:55432/yargram
# Without DATABASE_URL, existing installations keep JSON until explicitly migrated.
# DATA_DIR still controls uploads and the source JSON for db:import.
# DATA_DIR=C:/Games/YarGram/apps/server/data

# Ссылки на загруженные файлы и аватары подписаны и истекают (по умолчанию 24 часа).
# MEDIA_TOKEN_TTL_SECONDS=86400

# Шифрование данных в покое (at-rest): текст сообщений, черновики, отложенные
# сообщения и загруженные файлы лежат на диске зашифрованными AES-256-GCM.
# ОБЯЗАТЕЛЬНО в production и минимум 16 символов. Ключ менять нельзя: старые
# данные перестанут читаться. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=replace-with-at-least-16-random-characters

# Почта: код подтверждения при регистрации, входе и сбросе пароля.
# `console` — письмо печатается в лог (так сервер работает без настройки),
# `smtp` — настоящая отправка, `none` — не отправлять.
# MAIL_DRIVER=smtp
# SMTP2GO: 1000 писем/мес бесплатно, домен не нужен. Зарегистрируйтесь на
# smtp2go.com и создайте SMTP-пользователя в Settings → Users.
# MAIL_HOST=mail.smtp2go.com
# MAIL_PORT=2525
# MAIL_SECURE=false
# MAIL_USER=логин_smtp2go
# MAIL_PASS=пароль_smtp2go
# MAIL_FROM=noreply@example.com
# Запасные ящики: если основной отказал (пароль отозван, ящик заблокирован),
# письмо с кодом уходит со следующего. Настроек ровно те же, с суффиксом _2 и _3.
# Ящик без пароля пропускается.
# MAIL_USER_2=второй@example.com
# MAIL_PASS_2=пароль_приложения
# MAIL_FROM_2=второй@example.com
# MAIL_FROM_NAME=Yargram
# Срок жизни кода (секунды, по умолчанию 600).
# EMAIL_CODE_TTL_SECONDS=600
# Требовать код при регистрации и входе.
# EMAIL_CONFIRMATION=true
