{
  "name": "yargram",
  "version": "0.1.0",
  "private": true,
  "description": "Yargram 0.1 messenger for the Radmin VPN network",
  "workspaces": [
    "apps/server",
    "apps/web",
    "apps/landing"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install": "node scripts/install-workspaces.mjs",
    "build": "npm run build --workspace @yargram/web && npm run build --workspace @yargram/server && npm run build --workspace @yargram/landing",
    "dev": "concurrently --kill-others --names server,web,landing --prefix-colors blue,magenta,green \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:landing\"",
    "dev:server": "npm run dev --workspace @yargram/server",
    "dev:web": "npm run dev --workspace @yargram/web",
    "dev:landing": "npm run dev --workspace @yargram/landing",
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-yargram.ps1",
    "smoke": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "check:host": "node scripts/check-host.mjs",
    "cf:setup": "node scripts/setup-cloudflare.mjs",
    "db:local": "node scripts/local-postgres.mjs",
    "db:use-local": "node scripts/use-local-postgres.mjs",
    "db:import": "node --import tsx apps/server/src/migrate-json.ts",
    "db:to-json": "node scripts/backup-to-json.mjs",
    "backup": "node scripts/backup.mjs --force",
    "backup:status": "node scripts/backup.mjs --status",
    "bot:create": "node scripts/create-support-bot.mjs",
    "mail:test": "node scripts/test-mail.mjs",
    "mail:code": "node scripts/send-code-mail.mjs",
    "mail:password": "node scripts/set-mail-password.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm test",
    "check:ps": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-startup-syntax.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.65.0"
  }
}
