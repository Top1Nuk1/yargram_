NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Set HTTPS_PORT to 0 (or leave it empty) to disable the second listener.
HTTPS_PORT=0
# TLS_PFX_PATH=C:/absolute/path/to/yargram-server.pfx
# TLS_PFX_PASSWORD=replace-with-the-pfx-password
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Comma-separated extra origins. The temporary public dev origin is allowed by default.
CORS_ORIGINS=http://26.53.76.128:5173,http://localhost:5173
# DATA_DIR defaults to apps/server/data
# DATA_DIR=apps/server/data
# Upload links expire after this many seconds (default 24 hours, minimum 60).
# MEDIA_TOKEN_TTL_SECONDS=86400
# Encrypts message text and uploaded files at rest (AES-256-GCM). Never change
# it after the first run: previously stored data becomes unreadable.
# DB_ENCRYPTION_KEY=replace-with-at-least-16-random-characters

# Почта: код подтверждения при регистрации, входе и сбросе пароля.
# Драйвер `console` печатает письмо в лог (разработка), `smtp` — настоящая
# отправка, `none` — не отправлять ничего.
# MAIL_DRIVER=smtp
# Для SMTP2GO (бесплатно 1000 писем/мес, домен не нужен):
#   зарегистрируйтесь на smtp2go.com, в Settings → Users создайте SMTP-пользователя.
# MAIL_HOST=mail.smtp2go.com
# MAIL_PORT=2525        # 2525/8025/80 обходят блокировку 25-го порта провайдером
# MAIL_SECURE=false     # true только для SSL-порта 465
# MAIL_USER=ваше_имя_пользователя_smtp2go
# MAIL_PASS=пароль_smtp2go
# MAIL_FROM=noreply@ваш_домен_или_любой
# MAIL_FROM_NAME=Yargram
# Запасные ящики: если основной отказал (пароль отозван, ящик заблокирован),
# письмо с кодом уходит со следующего. Настройки те же, с суффиксом _2 и _3;
# ящик без пароля пропускается.
# MAIL_USER_2=второй@example.com
# MAIL_PASS_2=пароль_приложения
# MAIL_FROM_2=второй@example.com

# Срок жизни кода из письма, секунды (по умолчанию 600 — 10 минут).
# EMAIL_CODE_TTL_SECONDS=600
# Обязательное подтверждение почты кодом: регистрация и вход без кода не
# завершаются. По умолчанию выключено.
# EMAIL_CONFIRMATION=true

# Звонки: временные реквизиты TURN-релея (Open Relay / Metered и подобные).
# Публичные реле выдают логин и пароль на короткое время по HTTP — их нельзя
# зашить в сборку, поэтому сервер запрашивает их перед звонком. Адрес должен
# отдавать JSON с iceServers (см. docs/ИНСТРУКЦИЯ_RAVEN.md, раздел про звонки).
# Если не задан — звонки идут только по STUN: этого хватает в одной сети/VPN,
# но не всегда хватает в интернете (симметричный NAT).
# TURN_CREDENTIALS_URL=https://api.metered.live/v1/<ваш-ключ>/credentials
# TURN_CREDENTIALS_TTL_SECONDS=600   # сколько кэшировать полученные данные (30–86400, по умолчанию 600)
