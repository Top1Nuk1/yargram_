NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Set HTTPS_PORT to 0 (or leave it empty) to disable the second listener.
HTTPS_PORT=0
# TLS_PFX_PATH=C:/absolute/path/to/yargram-server.pfx
# TLS_PFX_PASSWORD=replace-with-the-pfx-password
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Comma-separated extra origins. The temporary public dev origin is allowed by default.
CORS_ORIGINS=http://26.236.251.44:5173,http://localhost:5173
# DATA_DIR defaults to apps/server/data
# DATA_DIR=apps/server/data
# Upload links expire after this many seconds (default 24 hours, minimum 60).
# MEDIA_TOKEN_TTL_SECONDS=86400
# Encrypts message text and uploaded files at rest (AES-256-GCM). Never change
# it after the first run: previously stored data becomes unreadable.
# DB_ENCRYPTION_KEY=replace-with-at-least-16-random-characters
